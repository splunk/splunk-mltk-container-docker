ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG TAG
ARG REQUIREMENTS_PYTHON_BASE
ARG REQUIREMENTS_PYTHON_SPECIFIC

# setup environment
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
# Keep python version in sync with the base image! agentic-ai-debian targets
# Python 3.11 (matching dhi.io/python:3.11-debian13-sfw-ent-dev).
ENV PATH=/dltk/.local/bin:/dltk/.local/lib/python3.11/site-packages/:$PATH
ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC

# The DHI development base includes a broad, independently-versioned Python
# environment. Isolate DSDL so packages left in that base cannot conflict with
# this image's combined requirements lock.
RUN python3 -m venv /opt/dltk-venv
ENV VIRTUAL_ENV=/opt/dltk-venv
ENV PATH=/opt/dltk-venv/bin:/dltk/.local/bin:/dltk/.local/lib/python3.11/site-packages/:$PATH

# curl not installed in some images :(
RUN apt-get update
RUN apt-get install curl -y

# Headers needed by wheels that fall back to sdists (lxml, openblas-backed
# builds, etc.).
RUN apt-get install -y libxml2-dev libxslt-dev pkg-config libopenblas-dev gfortran


# The NodeSource Debian 13 package depends on Debian's generic `python3`
# package, which removes the DHI image's Python 3.11 runtime and replaces it
# with Python 3.13. JupyterLab 4 ships prebuilt assets, so Node is not needed
# at runtime; retain the build tools without installing that conflicting package.
RUN apt-get update --fix-missing && apt-get install -y wget bzip2 git ca-certificates build-essential

# update everything
RUN apt-get update && apt-get upgrade -y

# configure file system
WORKDIR /srv
RUN mkdir /dltk

# The DHI base already provides Python 3.11 and pip. Use `python3 -m pip` to
# bypass its optional Socket Firewall wrapper, which requires a separate token.

# install base python requirements
COPY ./requirements_files/${REQUIREMENTS_PYTHON_BASE} /dltk/${REQUIREMENTS_PYTHON_BASE}
RUN python3 -m pip install --no-cache-dir --upgrade -r /dltk/${REQUIREMENTS_PYTHON_BASE}

# install specific python requirements
# langchain-aws[anthropic] and langchain-mcp-adapters are already declared in
# specific_llm_agentic.txt and therefore included in the combined lock.
COPY ./requirements_files/${REQUIREMENTS_PYTHON_SPECIFIC} /dltk/${REQUIREMENTS_PYTHON_SPECIFIC}
RUN python3 -m pip install --no-cache-dir --upgrade -r /dltk/${REQUIREMENTS_PYTHON_SPECIFIC}
# configure spacy if it was installed
RUN if python3 -m pip freeze | grep -q spacy;\
    then echo 'Spacy is installed, downloading language file...';\
    python3 -m spacy download en_core_web_sm;\
    else echo 'Spacy is not installed'; fi

# creating new self signed certs and/or copy custom certs
RUN openssl req -x509 -nodes -days 3650 -newkey rsa:2048 -keyout dltk.key -out dltk.pem -subj="/CN=dsdl"
COPY certificates .
RUN mkdir /dltk/.jupyter/; mv dltk.key /dltk/.jupyter/dltk.key; mv dltk.pem /dltk/.jupyter/dltk.pem; rm README.md

# Copy bootstrap entry point script
COPY ./bootstrap_scripts/bootstrap_fast.sh /dltk/
COPY ./bootstrap_scripts/bootstrap_backup.sh /dltk/
COPY app /dltk/app
# Activate the agentic FastAPI entrypoint for this image. The default
# /dltk/app/main.py (classic 5.2.5) does not import langgraph or
# langchain_mcp_adapters and is used by all non-agentic images. The agentic
# variant — which imports those plus the SplunkMCP / chatbot graph layers —
# ships as main_agentic.py and is promoted to main.py here.
RUN mv /dltk/app/main_agentic.py /dltk/app/main.py
COPY notebooks /dltk/notebooks

# Install dos2unix, then convert windows-like line endings to linux-like
# The bootstrap script won't run otherwise if the image was build on a windows machine
# Finally, remove dos2unix again
RUN apt-get update && apt-get install -y dos2unix
RUN find /dltk/ -name 'bootstrap_*.sh' -type f -exec dos2unix {} \;
RUN apt-get --purge remove -y dos2unix && rm -rf /var/lib/apt/lists/*

# Install local DSDL supporting functions
RUN mkdir /dltk/packages
COPY package-dsdlsupport/dist/dsdlsupport-1.0.0.tar.gz /dltk/packages/dsdlsupport-1.0.0.tar.gz
RUN python3 -m pip install /dltk/packages/dsdlsupport-1.0.0.tar.gz

# Copy jupyter config
COPY config/jupyter_notebook_config.py /dltk/.jupyter/jupyter_notebook_config.py

# Since JupyterLab 3 jupyter server config needs to be set
COPY config/jupyter_server_config.py /dltk/.jupyter/jupyter_server_config.py

# Copy jupyter notebook conversion template to export python module
COPY config/jupyter_notebook_template.tpl /dltk/.jupyter/jupyter_notebook_conversion.tpl
COPY config/null.tpl /dltk/.jupyter/null.tpl

# Handle user rights
RUN chgrp -R 0 /dltk && \
    chmod -R g=u /dltk
RUN chgrp -R 0 /srv && \
    chmod -R g=u /srv
RUN chmod g+w /etc/passwd
USER 1001

# Expose container port 5000 (MLTK Container Service) and 8888 (Notebook)
EXPOSE 5000 8888
# Define bootstrap as entry point to start container
ENTRYPOINT ["/dltk/bootstrap_fast.sh"]
