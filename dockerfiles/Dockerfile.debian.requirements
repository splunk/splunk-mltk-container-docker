ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG TAG
ARG COMPILED_REQUIREMENTS_FILE

USER root

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/80-build-retries
RUN apt-get update && apt-get upgrade -y

RUN mkdir /temp

RUN apt-get install -y --fix-missing python3 python3-pip libxml2-dev libxslt-dev pkg-config libopenblas-dev build-essential gfortran
RUN pip3 install -U pip setuptools wheel pip-tools

COPY ./requirements_files/${COMPILED_REQUIREMENTS_FILE} /temp/${COMPILED_REQUIREMENTS_FILE}
RUN cat /temp/${COMPILED_REQUIREMENTS_FILE}
RUN set -e; \
    attempt=1; \
    while [ "$attempt" -le 3 ]; do \
        if python3 -m piptools compile /temp/${COMPILED_REQUIREMENTS_FILE} --resolver=backtracking; then \
            exit 0; \
        fi; \
        echo "pip-tools attempt ${attempt} failed; retrying with a fresh package download." >&2; \
        attempt=$((attempt + 1)); \
        sleep 5; \
    done; \
    exit 1
